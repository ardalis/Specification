<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0;net472;</TargetFrameworks>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    
    <AssemblyName>Ardalis.Specification.EntityFramework6</AssemblyName>
    <PackageId>Ardalis.Specification.EntityFramework6</PackageId>
    <Title>Ardalis.Specification.EntityFramework6</Title>
    <Description>EF6 plugin package to Ardalis.Specification containing EF6 evaluator and abstract repository.</Description>
    <Summary>EF6 plugin package to Ardalis.Specification containing EF6 evaluator and abstract repository.</Summary>
    
    <Version>10.0.0</Version>
    <PackageTags>spec;specification;repository;ddd;ef;ef6;entity framework</PackageTags>
    <PackageReleaseNotes>
      Version 10.0.0 - the last MIT-licensed release. Future releases will require a (potentially free) commercial license: https://nimbletools.io/news/ardalis-nuget-packages/
      * Targets net10.0, net11.0 and netstandard2.0 (Ardalis.Specification), net10.0 and net11.0 (EntityFrameworkCore), net10.0, net11.0 and net472 (EntityFramework6)
      * Breaking: dropped net8.0 and net9.0 targets; EntityFrameworkCore package now requires EF Core 10 or 11
      * Updated all NuGet dependencies
      * NuGet package now ships its own focused readme
      Full change log: https://github.com/ardalis/Specification/releases
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EntityFramework"/>
    <PackageReference Include="Microsoft.CSharp"/>
    <PackageReference Include="System.Data.DataSetExtensions"/>
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Ardalis.Specification\Ardalis.Specification.csproj" />
  </ItemGroup>
  
</Project>
